# 1Password Connect via bjw-s app-template (no dedicated upstream chart).
controllers:
  connect:
    type: deployment
    replicas: 1
    strategy: Recreate
    containers:
      api:
        image:
          repository: docker.io/1password/connect-api
          tag: 1.8.1
        env:
          OP_HTTP_PORT: 8080
          XDG_DATA_HOME: /config
        probes:
          liveness: &probes
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /heartbeat
                port: 8080
              initialDelaySeconds: 0
              periodSeconds: 10
              timeoutSeconds: 1
              failureThreshold: 3
          readiness: *probes
          startup:
            enabled: false
        resources:
          requests:
            cpu: 15m
            memory: 48M
          limits:
            memory: 192M
        securityContext:
          allowPrivilegeEscalation: false
          capabilities: { drop: ["ALL"] }
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 999
          runAsGroup: 999
          seccompProfile: { type: RuntimeDefault }
      sync:
        image:
          repository: docker.io/1password/connect-sync
          tag: 1.8.1
        env:
          OP_HTTP_PORT: 8081
          XDG_DATA_HOME: /config
        resources:
          requests:
            cpu: 15m
            memory: 48M
          limits:
            memory: 192M
        securityContext:
          allowPrivilegeEscalation: false
          capabilities: { drop: ["ALL"] }
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 999
          runAsGroup: 999
          seccompProfile: { type: RuntimeDefault }
defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    runAsUser: 999
    runAsGroup: 999
    fsGroup: 999
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile: { type: RuntimeDefault }
service:
  connect:
    controller: connect
    ports:
      http:
        port: 8080
persistence:
  config:
    type: emptyDir
    advancedMounts:
      connect:
        api:
          - path: /config
            subPath: connect-api
        sync:
          - path: /config
            subPath: connect-sync
  # Seeded by ../secrets/secret.yaml (op inject), key 1password-credentials.json
  credentials:
    type: secret
    name: onepassword-connect-secret
    globalMounts:
      - path: /config
        readOnly: true
        subPath: 1password-credentials.json
