autoDirectNodeRoutes: true
bpf:
  masquerade: true
# NOTE: single-node cluster — no Gateway API LBIPBlocks yet; L2 announcement
# of the envoy-internal/external Service IPs handles ingress on the LAN.
# BGP (bgpControlPlane) can be added later if a second node or multi-VLAN
# service IPs ever make ECMP worthwhile.
cni:
  exclusive: false
gatewayAPI:
  enabled: true
  gatewayClass:
    create: "true"
hubble:
  enabled: false
ipam:
  mode: kubernetes
ipv4NativeRoutingCIDR: {{ .Values.cluster.podCIDR }}
k8sServiceHost: {{ .Values.cluster.endpoint }}
k8sServicePort: 6443
kubeProxyReplacement: true
l2announcements:
  enabled: true
operator:
  rollOutPods: true
rollOutCiliumPods: true
routingMode: native
securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - PERFMON
      - BPF
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
