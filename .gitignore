**/.terraform
bin/
.vscode

# Mise
.mise.local.toml

# Sops
.decrypted~*.yaml

# Home Assistant runtime secrets (PVC-only; may contain station MACs/locations)
**/secrets.yaml

# Helm
*Chart.lock
terraform.tfstate*
.vm/

# Ignition files (contain secrets like SSH keys)
infra/flatcar/ignition/*.ign

# Python bytecode (scripts/ and the paperless extractor)
__pycache__/
*.pyc
