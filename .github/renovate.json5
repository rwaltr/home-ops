{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // home-operations preset (as used by onedr0p/home-ops) wires up the flux,
  // helm-values, kubernetes and kustomize managers for infra/k8s/kyz, plus
  // oci:// + "# renovate:" annotated custom managers and container digest handling.
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    ":timezone(America/Chicago)",
    ":enablePreCommit",
    "github>rwaltr/home-ops//.github/renovate/autoMerge",
    "github>rwaltr/home-ops//.github/renovate/labels",
  ],
  suppressNotifications: ["prIgnoreNotification"],
  // keep PRs current so lint:fmt (whole-repo oxfmt check) always sees the
  // formatted tree; auto-rebases stale PRs instead of only conflicted ones
  rebaseWhen: "behind-base-branch",
}
