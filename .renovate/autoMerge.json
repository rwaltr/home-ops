{
  "packageRules": [
    {
      "description": "Auto-merge trusted home-operations container digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["/home-operations/"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge GitHub Actions (minor/patch/digest)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Auto-merge trusted GitHub Actions immediately",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "/^actions\\//",
        "/^renovatebot\\//",
        "/^tibdex\\//",
        "/^oxsecurity\\//"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "1 day"
    }
  ]
}
