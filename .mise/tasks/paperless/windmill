#!/usr/bin/env bash
#MISE description="Deploy the Paperless Windmill scripts, secret refs, and schedules"
set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

for c in fnox python3; do
  command -v "$c" >/dev/null || die "$c not found on PATH"
done

fnox exec --only WINDMILL_TOKEN,PAPERLESS_API_TOKEN,IMMICH_PAPERLESS_API_KEY \
  --refresh WINDMILL_TOKEN --refresh PAPERLESS_API_TOKEN --refresh IMMICH_PAPERLESS_API_KEY \
  --redact -- bash -s <<'SH'
set -euo pipefail
python3 scripts/paperless_windmill_secrets.py
wmill() { mise x node@24.22.0 -- npx --yes windmill-cli@1.881.1 "$@"; }
wmill resource-type push paperless_api.resource-type.yaml paperless_api \
  --base-url https://windmill.waltr.tech --workspace admins --token "$WINDMILL_TOKEN"
wmill resource-type push immich_api.resource-type.yaml immich_api \
  --base-url https://windmill.waltr.tech --workspace admins --token "$WINDMILL_TOKEN"
wmill sync push --base-url https://windmill.waltr.tech --workspace admins \
  --token "$WINDMILL_TOKEN" --include-schedules --yes
SH
