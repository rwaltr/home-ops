#!/usr/bin/env bash
#MISE description="Build Flatcar Ignition configs from Butane (base, test, hosts/*)"
#MISE sources=["infra/flatcar/butane/**/*.bu"]
#MISE outputs=["infra/flatcar/ignition/base.ign", "infra/flatcar/ignition/test.ign", "infra/flatcar/ignition/mouse.ign"]

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

BUTANE_DIR="${MISE_PROJECT_ROOT}/infra/flatcar/butane"
IGN_DIR="${MISE_PROJECT_ROOT}/infra/flatcar/ignition"

mkdir -p "${IGN_DIR}"

compile() {
    local src="$1" dst="$2"
    local tmp_file err_file
    tmp_file=$(mktemp) err_file=$(mktemp)
    # --files-dir is the repo root so `local: infra/flatcar/ignition/base.ign`
    # merge references resolve
    if ! butane --pretty --strict --files-dir "${MISE_PROJECT_ROOT}" < "${src}" > "${tmp_file}" 2> "${err_file}"; then
        log "ERROR: Failed to build ${src##*/}"
        cat "${err_file}" >&2
        rm -f "${tmp_file}" "${err_file}"
        exit 1
    fi
    rm -f "${err_file}"
    if [ ! -s "${tmp_file}" ]; then
        rm -f "${tmp_file}"
        die "Output file is empty for ${src##*/}"
    fi
    mv "${tmp_file}" "${dst}"
    log "✓ Built ${dst##*/} ($(wc -l < "${dst}") lines)"
}

# base.ign first: host configs merge it
compile "${BUTANE_DIR}/base.bu" "${IGN_DIR}/base.ign"
compile "${BUTANE_DIR}/test.bu" "${IGN_DIR}/test.ign"
for host_bu in "${BUTANE_DIR}"/hosts/*.bu; do
    [ -e "${host_bu}" ] || continue
    name=$(basename "${host_bu}" .bu)
    [ "${name}" = "template" ] && continue   # skeleton for new hosts, not a real config
    compile "${host_bu}" "${IGN_DIR}/${name}.ign"
done
