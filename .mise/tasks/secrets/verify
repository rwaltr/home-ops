#!/usr/bin/env bash
#MISE description="Verify every 1Password item/field the cluster's ExternalSecrets reference"
#USAGE flag "-v --verbose" help="List every reference checked, not just the failures"

set -euo pipefail
source "$MISE_CONFIG_ROOT/.mise/lib/common.sh"

# All cluster secrets come from the one vault clusterSecretStore
# `onepassword-connect` maps in:
#   infra/k8s/kyz/apps/external-secrets/onepassword-connect/app/clustersecretstore.yaml
VAULT="home-ops"
K8S_DIR="infra/k8s"

for c in op yq jq rg; do
  command -v "$c" >/dev/null || die "$c not found on PATH"
done

# Same discipline as the tf:* tasks: resolve only the credential this needs.
# An already-exported token wins, so this works in CI and from a shell.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  OP_SERVICE_ACCOUNT_TOKEN="$(fnox get OP_SERVICE_ACCOUNT_TOKEN)" \
    || die "could not resolve OP_SERVICE_ACCOUNT_TOKEN (see: mise run op:token)"
  export OP_SERVICE_ACCOUNT_TOKEN
fi

# Every referenced item/field, derived from the manifests rather than listed
# here: the ExternalSecrets are the contract, so this cannot drift from them.
# Prints: <item> TAB <field|*> TAB <file> TAB <external-secret name>
#
# Field "*" means the ExternalSecret extracts the whole item (dataFrom.extract),
# so it has no single field to check — the fields it consumes appear in the
# target template instead, checked separately below.
refs() {
  local f
  while IFS= read -r f; do
    # The yq program names the file itself, so it needs no yq variable for it;
    # $n below is a yq variable, not a shell one.
    # shellcheck disable=SC2016
    # yq emits tab-separated rows; this re-emits them with a unit separator
    # instead. A tab is IFS *whitespace*, so consecutive tabs collapse and an
    # empty field silently shifts everything after it along. -N stops yq writing
    # "---" between the documents of a file holding more than one ExternalSecret
    # (which would arrive here as a one-field row), and the guard drops the blank
    # line yq prints when one branch of the comma expression matches nothing.
    while IFS=$'\t' read -r item field name; do
      [ -n "$item" ] || continue
      printf '%s\037%s\037%s\037%s\n' "$item" "$field" "$f" "$name"
    done < <(yq -r -N '
      select(.kind == "ExternalSecret" or .kind == "ClusterExternalSecret")
      | .metadata.name as $n
      | ((.spec.data // [])[] | [.remoteRef.key, (.remoteRef.property // "*"), $n] | @tsv),
        ((.spec.dataFrom // [])[] | [(.extract.key // .find.name // "?undetermined"), "*", $n] | @tsv)
    ' "$f")
  done < <(rg -l --glob '*.yaml' '^kind: (ExternalSecret|ClusterExternalSecret)$' "$K8S_DIR" | sort)
}

mapfile -t REF_LINES < <(refs)
[ "${#REF_LINES[@]}" -gt 0 ] || die "no ExternalSecrets found under $K8S_DIR"

# Fields per item and items per file are newline-separated, and always walked
# with a read loop. Never iterate these with ${arr[$k]}: word splitting would cut
# "reolink local admin" into three, and the "*" marker would be treated as a
# glob and expand to the repo's filenames.
declare -A ITEM_FIELDS=() FILE_ITEMS=() LABELS=()
for line in "${REF_LINES[@]}"; do
  IFS=$'\037' read -r item field file _name <<<"$line"
  ITEM_FIELDS[$item]="${ITEM_FIELDS[$item]:-}$field"$'\n'
  FILE_ITEMS[$file]="${FILE_ITEMS[$file]:-}$item"$'\n'
done

# One listing call for existence and for the unreferenced-item report.
VAULT_JSON="$(op item list --vault "$VAULT" --format json 2>/dev/null)" \
  || die "could not list vault '$VAULT' — is the token valid? (mise run op:token)"
mapfile -t VAULT_TITLES < <(jq -r '.[].title' <<<"$VAULT_JSON" | sort)
[ "${#VAULT_TITLES[@]}" -gt 0 ] || die "vault '$VAULT' appears empty or is not visible to this token"

vault_has() { printf '%s\n' "${VAULT_TITLES[@]}" | grep -Fxq -- "$1"; }

# Labels only, never values: an empty field is as good as a missing one to the
# pod that consumes it, so only populated fields count as present.
item_labels() {
  if [ -z "${LABELS[$1]+set}" ]; then
    LABELS[$1]="$(op item get "$1" --vault "$VAULT" --format json 2>/dev/null \
      | jq -r '.fields[]? | select((.value // "") != "") | .label' | sort -u)"
  fi
  printf '%s\n' "${LABELS[$1]}"
}

missing_items=() missing_fields=() unresolved_refs=()

for item in "${!ITEM_FIELDS[@]}"; do
  if ! vault_has "$item"; then
    missing_items+=("$item")
    continue
  fi
  labels="$(item_labels "$item")"
  while IFS= read -r field; do
    [ -n "$field" ] || continue
    [ "$field" = "*" ] && continue
    grep -Fxq -- "$field" <<<"$labels" || missing_fields+=("$item/$field")
  done <<<"${ITEM_FIELDS[$item]}"
done

# Template references: what the ExternalSecret actually copies into the Secret
# (`{{ .field }}`). Checked per file, against the fields of that file's items
# plus its data[].secretKeys — a template may reference either — so a file with
# several extracts doesn't produce a false alarm about which item owns a name.
for file in "${!FILE_ITEMS[@]}"; do
  mapfile -t wanted < <(rg -o --no-filename '\{\{ \.[A-Za-z0-9_]+ \}\}' "$file" 2>/dev/null \
    | sed -E 's/.*\.([A-Za-z0-9_]+).*/\1/' | sort -u)
  [ "${#wanted[@]}" -gt 0 ] || continue

  provided=""
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    vault_has "$item" && provided+="$(item_labels "$item")"$'\n'
  done <<<"${FILE_ITEMS[$file]}"
  provided+="$(yq -r 'select(.kind == "ExternalSecret" or .kind == "ClusterExternalSecret")
    | (.spec.data // [])[].secretKey' "$file" 2>/dev/null)"

  for want in "${wanted[@]}"; do
    grep -Fxq -- "$want" <<<"$provided" || unresolved_refs+=("${file#"${K8S_DIR}"/} → .$want")
  done
done

if [ -n "${usage_verbose:-}" ]; then
  log "Checked ${#REF_LINES[@]} references across ${#ITEM_FIELDS[@]} items:"
  while IFS= read -r item; do
    log "  $item ← $(tr '\n' ' ' <<<"${ITEM_FIELDS[$item]}")"
  done < <(printf '%s\n' "${!ITEM_FIELDS[@]}" | sort)
fi

referenced=$(printf '%s\n' "${!ITEM_FIELDS[@]}" | sort)
extras=$(comm -23 <(printf '%s\n' "${VAULT_TITLES[@]}") <(printf '%s\n' "$referenced"))
if [ -n "$extras" ]; then
  # Not a problem: Terraform, the host and CLI tooling use this vault too.
  log "not referenced by any ExternalSecret: $(tr '\n' ' ' <<<"$extras" | sed 's/ $//')"
fi

problems=0
if [ "${#missing_items[@]}" -gt 0 ]; then
  problems=$((problems + ${#missing_items[@]}))
  log "MISSING ITEMS — no such 1Password item in vault '$VAULT':"
  printf '  %s\n' "${missing_items[@]}" >&2
fi
if [ "${#missing_fields[@]}" -gt 0 ]; then
  problems=$((problems + ${#missing_fields[@]}))
  log "MISSING/EMPTY FIELDS — the ExternalSecret asks for a field the item does not have:"
  printf '  %s\n' "${missing_fields[@]}" >&2
fi
if [ "${#unresolved_refs[@]}" -gt 0 ]; then
  problems=$((problems + ${#unresolved_refs[@]}))
  log "UNRESOLVED TEMPLATE REFS — nothing in that ExternalSecret provides this name:"
  printf '  %s\n' "${unresolved_refs[@]}" >&2
fi

if [ "$problems" -gt 0 ]; then
  die "$problems problem(s) — a cluster using these specs would fail to get its secrets"
fi

log "OK: ${#REF_LINES[@]} references across ${#ITEM_FIELDS[@]} items all resolve"
