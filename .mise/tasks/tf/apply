#!/usr/bin/env bash
#MISE description="Apply Terraform changes for a workspace"
#MISE confirm='Apply Terraform changes in {{usage.dir}}?'
#USAGE arg "<dir>" help="Terraform workspace" {
#USAGE   choices "cloudflare" "tf-cloud"
#USAGE }
#USAGE arg "[tf-args]" varargs help="Extra args passed to terraform (e.g. -target=x)"

set -euo pipefail

# Export only the credentials terraform needs rather than `fnox exec`-ing the
# whole environment: provider plugins are third-party binaries and can read every
# variable they are handed. `fnox get` fails (and set -e aborts) if unavailable.
CLOUDFLARE_API_TOKEN=$(fnox get CLOUDFLARE_API_TOKEN)
PORKBUN_API_KEY=$(fnox get PORKBUN_API_KEY)
PORKBUN_SECRET_KEY=$(fnox get PORKBUN_SECRET_KEY)
export CLOUDFLARE_API_TOKEN PORKBUN_API_KEY PORKBUN_SECRET_KEY

# shellcheck disable=SC2086
terraform -chdir="${MISE_PROJECT_ROOT}/infra/terraform/${usage_dir?}" apply ${usage_tf_args:-}
