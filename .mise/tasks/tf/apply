#!/usr/bin/env bash
#MISE description="Apply Terraform changes for a workspace"
#MISE confirm='Apply Terraform changes in {{usage.dir}}?'
#USAGE arg "<dir>" help="Terraform workspace" {
#USAGE   choices "cloudflare" "backblaze" "tf-cloud"
#USAGE }
#USAGE arg "[tf-args]" varargs help="Extra args passed to terraform (e.g. -target=x)"

set -euo pipefail

terraform -chdir="${MISE_PROJECT_ROOT}/infra/terraform/${usage_dir?}" apply ${usage_tf_args:-}
