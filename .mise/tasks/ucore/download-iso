#!/usr/bin/env bash
#MISE description="Download Fedora CoreOS ISO (shared across hosts)"
#MISE outputs=[".vm/fedora-coreos-stable.iso"]

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

ISO_PATH="${MISE_PROJECT_ROOT}/.vm/fedora-coreos-stable.iso"

# Fetch stream metadata for the download URL and expected checksum
STREAM="stable"
STREAM_JSON=$(curl -sf "https://builds.coreos.fedoraproject.org/streams/${STREAM}.json")
ISO_URL=$(echo "${STREAM_JSON}" | python3 -c "import sys, json; print(json.load(sys.stdin)['architectures']['x86_64']['artifacts']['metal']['formats']['iso']['disk']['location'])")
ISO_SHA256=$(echo "${STREAM_JSON}" | python3 -c "import sys, json; print(json.load(sys.stdin)['architectures']['x86_64']['artifacts']['metal']['formats']['iso']['disk']['sha256'])")

download_artifact "${ISO_URL}" "${ISO_SHA256}" "${ISO_PATH}"
