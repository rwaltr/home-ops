#!/usr/bin/env bash
#MISE description="Build a single Ignition file from Butane config"
#USAGE arg "<config-name>" help="Name of the config file (without .bu extension)"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

BUTANE_DIR="${MISE_PROJECT_ROOT}/infra/ucore/butane"
HOSTS_DIR="${BUTANE_DIR}/hosts"
OUTPUT_DIR="${MISE_PROJECT_ROOT}/infra/ucore/ignition"

mkdir -p "${OUTPUT_DIR}"

config_name="${usage_config_name?}"
butane_file="${BUTANE_DIR}/${config_name}.bu"

if [ ! -f "${butane_file}" ]; then
    butane_file="${HOSTS_DIR}/${config_name}.bu"
fi

if [ ! -f "${butane_file}" ]; then
    die "${config_name}.bu not found in butane/ or butane/hosts/"
fi

basename=$(basename "${butane_file}" .bu)
output_file="${OUTPUT_DIR}/${basename}.ign"

log "Building ${basename}.bu → ${basename}.ign"

# Write to a temp file so butane errors never poison the tracked output
tmp_file=$(mktemp) err_file=$(mktemp)
if ! butane --strict --pretty --files-dir "${MISE_PROJECT_ROOT}" < "${butane_file}" > "${tmp_file}" 2> "${err_file}"; then
    log "ERROR: Failed to build ${butane_file}"
    cat "${err_file}" >&2
    rm -f "${tmp_file}" "${err_file}"
    exit 1
fi
rm -f "${err_file}"

if [ ! -s "${tmp_file}" ]; then
    rm -f "${tmp_file}"
    die "Output file is empty"
fi

mv "${tmp_file}" "${output_file}"
log "✓ Generated ${output_file} ($(wc -l < "${output_file}") lines)"
