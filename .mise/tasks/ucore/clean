#!/usr/bin/env bash
#MISE description="Clean up uCore VMs and disk images"
#MISE confirm='Destroy VMs and disk images for {{usage.hostname | default(value="ALL hosts")}}?'
#USAGE arg "[hostname]" help="Host to clean (default: all hosts)"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

VM_DIR="${MISE_PROJECT_ROOT}/.vm"
HOSTNAME="${usage_hostname:-}"

virsh_available() {
    if ! command -v virsh &> /dev/null; then
        log "Warning: virsh not found. Skipping VM cleanup."
        return 1
    fi

    if ! virsh --connect qemu:///system list --all &> /dev/null; then
        log "Warning: Cannot connect to libvirt system. Skipping VM cleanup."
        return 1
    fi

    return 0
}

clean_vm() {
    local vm_name="$1"

    if ! virsh --connect qemu:///system list --all | grep -q "${vm_name}"; then
        log "VM '${vm_name}' does not exist, skipping"
        return
    fi

    log "Destroying VM: ${vm_name}"
    virsh --connect qemu:///system destroy "${vm_name}" 2>/dev/null || true

    log "Undefining VM: ${vm_name}"
    virsh --connect qemu:///system undefine "${vm_name}" --nvram 2>/dev/null || true

    log "✓ Cleaned up VM: ${vm_name}"
}

clean_disks() {
    local pattern="$1"

    if [ ! -d "${VM_DIR}" ]; then
        log "VM directory does not exist: ${VM_DIR}"
        return
    fi

    local files_found=false
    for file in "${VM_DIR}"/${pattern}; do
        if [ -f "${file}" ]; then
            files_found=true
            log "Removing: $(basename "${file}")"
            rm -f "${file}"
        fi
    done

    if [ "$files_found" = false ]; then
        log "No disk files found matching: ${pattern}"
    else
        log "✓ Cleaned up disk files"
    fi
}

if [ -n "${HOSTNAME}" ]; then
    log "Cleaning up host: ${HOSTNAME}"

    if virsh_available; then
        clean_vm "ucore-${HOSTNAME}-test"
    fi

    clean_disks "ucore-${HOSTNAME}*.qcow2"
    clean_disks "fedora-coreos-${HOSTNAME}-autoinstall.iso"
    clean_disks "fedora-coreos-${HOSTNAME}-*-autoinstall.iso"
else
    log "Cleaning up all uCore VMs and disks"

    if virsh_available; then
        vm_list=$(virsh --connect qemu:///system list --all --name | grep "^ucore-" || true)

        if [ -n "${vm_list}" ]; then
            log "Found VMs:"
            echo "${vm_list}" | sed 's/^/  - /'

            while IFS= read -r vm_name; do
                [ -z "${vm_name}" ] && continue
                clean_vm "${vm_name}"
            done <<< "${vm_list}"
        else
            log "No uCore VMs found"
        fi
    fi

    clean_disks "ucore-*.qcow2"
    clean_disks "fedora-coreos-*-autoinstall.iso"
fi

log "✓ Cleanup complete"
log "Kept (shared resources): .vm/fedora-coreos-stable.iso, infra/ucore/ignition/"
log "To remove these as well: rm .vm/fedora-coreos-stable.iso && rm -rf infra/ucore/ignition/"
