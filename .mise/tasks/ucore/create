#!/usr/bin/env bash
#MISE description="Create uCore VM (disks + virt-install) for a host"
#MISE depends=[{ task = "ucore:customize-iso", args = ["{{usage.hostname}}"] }]
#USAGE flag "--force" env="UCORE_FORCE" help="Force recreate VM even if it exists"
#USAGE arg "[hostname]" env="UCORE_HOST" default="mouse" help="Host to install"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

HOSTNAME="${usage_hostname?}"
FORCE="${usage_force:-false}"
VM_NAME="ucore-${HOSTNAME}-test"
VM_DIR="${MISE_PROJECT_ROOT}/.vm"
# VMs always use /dev/vda, so ISO is device-specific
CUSTOM_ISO_PATH="${VM_DIR}/fedora-coreos-${HOSTNAME}-vda-autoinstall.iso"
DISK_PATH="${VM_DIR}/ucore-${HOSTNAME}.qcow2"
ZFS_DISK_PATH="${VM_DIR}/ucore-${HOSTNAME}-zfs.qcow2"

create_disks() {
    if [ ! -f "${DISK_PATH}" ]; then
        log "Creating main disk (40GB)..."
        qemu-img create -f qcow2 "${DISK_PATH}" 40G
        log "✓ Created ${DISK_PATH}"
    else
        log "✓ Main disk already exists"
    fi

    if [ ! -f "${ZFS_DISK_PATH}" ]; then
        log "Creating ZFS disk (20GB)..."
        qemu-img create -f qcow2 "${ZFS_DISK_PATH}" 20G
        log "✓ Created ${ZFS_DISK_PATH}"
    else
        log "✓ ZFS disk already exists"
    fi
}

# Check if VM already exists
if virsh --connect qemu:///system list --all --name 2>/dev/null | grep -q "^${VM_NAME}$"; then
    if [ "${FORCE}" != "true" ]; then
        log "❌ VM '${VM_NAME}' already exists!"
        echo ""
        echo "Options:"
        echo "  1. Connect to existing VM:"
        echo "     mise run ucore:vm-connect ${HOSTNAME}"
        echo ""
        echo "  2. Force recreate (destroys existing VM):"
        echo "     mise run ucore:vm --force ${HOSTNAME}"
        echo ""
        echo "  3. Clean up and recreate:"
        echo "     mise run ucore:clean ${HOSTNAME}"
        echo "     mise run ucore:vm ${HOSTNAME}"
        exit 1
    else
        log "⚠️  Force recreating VM '${VM_NAME}'..."
        mise run ucore:clean "${HOSTNAME}"
    fi
fi

create_disks
check_virsh

log "Creating and starting VM: ${VM_NAME}"

virt-install \
    --connect qemu:///system \
    --name "${VM_NAME}" \
    --memory 4096 \
    --vcpus 2 \
    --os-variant fedora-coreos-stable \
    --disk "path=${DISK_PATH},format=qcow2,bus=virtio" \
    --disk "path=${ZFS_DISK_PATH},format=qcow2,bus=virtio" \
    --network network=default,model=virtio \
    --graphics spice,listen=127.0.0.1 \
    --console pty,target_type=serial \
    --noautoconsole \
    --cdrom "${CUSTOM_ISO_PATH}" \
    --boot cdrom,hd

log "✓ VM created and installation started"
