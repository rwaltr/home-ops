#!/usr/bin/env bash
#MISE description="Connect to running uCore VM"
#USAGE arg "[hostname]" env="UCORE_HOST" default="mouse" help="Host to connect to"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

HOSTNAME="${usage_hostname?}"
VM_NAME="ucore-${HOSTNAME}-test"

check_virsh

if ! virsh --connect qemu:///system list --all | grep -q "${VM_NAME}"; then
    die "VM '${VM_NAME}' does not exist. Run 'mise run ucore:vm ${HOSTNAME}' first to create and install."
fi

if ! virsh --connect qemu:///system list | grep -q "${VM_NAME}"; then
    log "Starting VM..."
    virsh --connect qemu:///system start "${VM_NAME}"
    sleep 3
else
    log "✓ VM is already running"
fi

VM_IP=$(virsh --connect qemu:///system domifaddr "${VM_NAME}" 2>/dev/null | grep -oP '(\d{1,3}\.){3}\d{1,3}' | head -1 || true)

if [ -n "${VM_IP}" ]; then
    log "VM IP: ${VM_IP} — ssh rwaltr@${VM_IP}"
else
    log "No IP address yet — VM may still be installing"
fi

if command -v virt-manager &>/dev/null; then
    log "Opening virt-manager console..."
    virt-manager --connect qemu:///system --show-domain-console "${VM_NAME}" &>/dev/null &
else
    log "virt-manager not found. Console access: virsh --connect qemu:///system console ${VM_NAME}"
fi
