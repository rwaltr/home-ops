#!/usr/bin/env bash
#MISE description="Create and auto-install uCore VM, then wait until it is SSH-ready"
#MISE depends=[{ task = "ucore:create", args = ["{{usage.hostname}}"], env = { UCORE_FORCE = '{{usage.force | default(value="")}}' } }]
#MISE depends_post=[{ task = "ucore:vm-wait", args = ["{{usage.hostname}}"] }]
#USAGE flag "--force" help="Force recreate VM even if it exists"
#USAGE arg "[hostname]" env="UCORE_HOST" default="mouse" help="Host to install"

# Orchestrator task. The real work happens in the dependency chain:
#   ucore:build + ucore:download-iso → ucore:customize-iso → ucore:create → (this) → ucore:vm-wait

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.mise/lib/common.sh"

VM_NAME="ucore-${usage_hostname?}-test"

if command -v virt-manager &>/dev/null; then
    log "Opening virt-manager console for ${VM_NAME}..."
    virt-manager --connect qemu:///system --show-domain-console "${VM_NAME}" &>/dev/null &
else
    log "virt-manager not found. Watch install progress with:"
    log "  virsh --connect qemu:///system console ${VM_NAME}"
fi
