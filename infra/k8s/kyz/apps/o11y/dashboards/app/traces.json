    {
      "id": 7,
      "type": "stat",
      "title": "Metric series from spans",
      "description": "Series Tempo's metrics generator writes to Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(traces_spanmetrics_calls_total)",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
