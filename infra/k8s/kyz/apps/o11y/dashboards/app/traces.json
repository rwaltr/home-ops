    {
      "id": 20,
      "type": "table",
      "title": "Slow ingress requests (over 1s)",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"envoy.*\" && duration > 1s }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
