#!/command/with-contenv sh
# s6-applyuidgid shim for non-root Frigate (frigate discussion #18375):
# this runtime does not honor caps.add=[SETGID] for non-root containers,
# so setgroups always EPERMs and every s6 log service crashloops.
# Strip the uid/gid flags and run the command as the container uid —
# our log-prepare override already chowns /dev/shm/logs/* to that uid.
while [ "$#" -gt 0 ]; do
  case "$1" in
    -u|-g|-G|-g') shift 2 ;;
    -U|-z) shift 1 ;;
    -u*|-U*|-g*|-G*) shift 1 ;;
    *) break ;;
  esac
done
[ "$#" -eq 0 ] && exit 0
exec "$@"