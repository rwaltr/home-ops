#!/command/with-contenv bash
# shellcheck shell=bash
# Prepare the logs folder for s6-log
# Non-root override (frigate discussion #18375): the image's version chowns
# nobody:nogroup — impossible without CAP_CHOWN. Dirs stay uid 1000; the
# log services run under S6_CATCHALL_USER=1000 anyway.
set -o errexit -o nounset -o pipefail

dirs=(/dev/shm/logs/frigate /dev/shm/logs/go2rtc /dev/shm/logs/nginx /dev/shm/logs/certsync)

umask 022
mkdir -p "${dirs[@]}"