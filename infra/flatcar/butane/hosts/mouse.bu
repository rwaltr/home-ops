variant: flatcar
version: 1.1.0
# Host configuration for 'mouse' — ZFS storage node + single-node k0s.
# Build: mise run flatcar:build  (merges infra/flatcar/ignition/base.ign)
#
# Reality notes (from live mouse, 2026-08-13):
#   - mgmt: static 10.10.0.10 on 10.10.0.0/16 (MAC-matched; was DHCP .105 on uCore),
#     NIC igc/enp88s0 (i226-LM, also the AMT/vPro port)
#   - ZFS: 'tank' created by hand (raidz1 x2, 6x 5.5T), mountpoint /var/tank —
#     this config IMPORTS, never creates
#   - VLANs 30 (iot) / 40 (cameras) are NOT on the host; k8s reaches them
#     (home-assistant/macvlan or BGP, phase 4)

ignition:
  config:
    merge:
      - local: infra/flatcar/ignition/base.ign

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          mouse

    # ZFS hostid — must match the pool's creator host or import needs -f
    - path: /etc/hostid
      mode: 0644
      contents:
        inline: |
          1e1719e4

    # Official Flatcar ZFS sysext (rides OS updates, no pinning needed)
    - path: /etc/flatcar/enabled-sysext.conf
      mode: 0644
      contents:
        inline: |
          zfs

    # Bare-metal NIC (i226-LM, matched by MAC): static 10.10.0.10.
    # Sorts before 25-primary.network so it wins on the real hardware;
    # the qemu VM's virtio MAC doesn't match and falls through to DHCP.
    - path: /etc/systemd/network/20-mouse-static.network
      mode: 0644
      contents:
        inline: |
          [Match]
          MACAddress=58:47:ca:74:fb:1c

          [Network]
          Address=10.10.0.10/24
          Address=fdad:207a:f1ab:10::10/64
          # SLAAC alongside the static address — RA also provides the v6 default route
          IPv6AcceptRA=yes
          Gateway=10.10.0.1
          DNS=10.10.0.1
          MulticastDNS=yes
          LLMNR=yes
          # Bind the tagged VLANs to this (master) interface.
          # (note: VLAN= is a [Network] option — a [VLAN] section is netdev-only)
          VLAN=enp88s0.20
          VLAN=enp88s0.30
          VLAN=enp88s0.40

    # VLAN subinterfaces for macvlan masters (multus): 20-clients, 30-iot,
    # 40-cameras. ether4-study is a trunk (PVID 10, tagged 10/20/30/40/60).
    # L2 only: no addressing, pods own their IPs via the NADs.
    # NOTE: these sort as 15-* — BEFORE this file's 20-mouse-static.network —
    # because vlan subinterfaces inherit the parent's MAC and would otherwise
    # be matched (and re-configured!) by the MAC match below.
    - path: /etc/systemd/network/15-mouse-vlan20.netdev
      mode: 0644
      contents:
        inline: |
          [NetDev]
          Name=enp88s0.20
          Kind=vlan

          [VLAN]
          Id=20

    - path: /etc/systemd/network/15-mouse-vlan20.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=enp88s0.20

          [Network]
          LinkLocalAddressing=no
          IPv6AcceptRA=no # no default route via these VLANs

    - path: /etc/systemd/network/15-mouse-vlan30.netdev
      mode: 0644
      contents:
        inline: |
          [NetDev]
          Name=enp88s0.30
          Kind=vlan

          [VLAN]
          Id=30

    - path: /etc/systemd/network/15-mouse-vlan30.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=enp88s0.30

          [Network]
          LinkLocalAddressing=no
          IPv6AcceptRA=no # no default route via these VLANs

    - path: /etc/systemd/network/15-mouse-vlan40.netdev
      mode: 0644
      contents:
        inline: |
          [NetDev]
          Name=enp88s0.40
          Kind=vlan

          [VLAN]
          Id=40

    - path: /etc/systemd/network/15-mouse-vlan40.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=enp88s0.40

          [Network]
          LinkLocalAddressing=no
          IPv6AcceptRA=no # no default route via these VLANs

    # Fallback: any other NIC (VMs, new hardware) gets DHCP + mDNS.
    - path: /etc/systemd/network/25-primary.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=en* eth*

          [Network]
          DHCP=yes
          MulticastDNS=yes
          LLMNR=yes

          [DHCPv4]
          UseDNS=yes
          UseRoutes=yes

systemd:
  units:
    # Import the existing 'tank' pool + mount its datasets.
    # Production pool was created by hand; never create here.
    # Idempotent: import -a / mount -a are no-ops when already done.
    # Runs after sysext merge so zpool/zfs binaries exist.
    - name: zfs-import-tank.service
      enabled: true
      contents: |
        [Unit]
        Description=Import existing ZFS pools and mount datasets
        # After sysext merge so /usr/bin/zpool exists (proven pattern from
        # flatcar-test: multi-user.target is late enough)
        After=systemd-sysext.service
        Wants=systemd-sysext.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/zpool import -a
        ExecStart=/usr/bin/zfs mount -a

        [Install]
        WantedBy=multi-user.target
