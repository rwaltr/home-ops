{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // home-operations preset (as used by onedr0p/home-ops) wires up the flux,
  // helm-values, kubernetes and kustomize managers for infra/k8s/kyz, plus
  // oci:// + "# renovate:" annotated custom managers and container digest handling.
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    ":timezone(America/Chicago)",
    // local> resolves on the platform Renovate runs on: Forgejo.
    "local>rwaltr/home-ops//.renovate/autoMerge",
    "local>rwaltr/home-ops//.renovate/labels",
  ],
  suppressNotifications: ["prIgnoreNotification"],
  // Rebase only on conflict. "behind-base-branch" re-ran lint on every open PR
  // after each merge to master; on one node that saturated the NVMe for an hour.
  // A PR's lint can be a little stale against master, which is fine here.
  rebaseWhen: "conflicted",
  // The home-operations preset turns rate limits off (:disableRateLimiting);
  // put them back so a first run or a big release day doesn't open 50 PRs at
  // once, each starting a ~2 GB lint job.
  prConcurrentLimit: 10,
  prHourlyLimit: 5,
  // Forgejo branch protection (lint + 1 approval, no pushes) refuses branch
  // automerge, so automerge goes through PRs: Renovate opens one and asks
  // Forgejo to merge it once its checks succeed. kritika is the approval —
  // .kritika.yaml approves Renovate's PRs that its review finds clean.
  automergeType: "pr",
  platformAutomerge: true,
}
